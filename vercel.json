{
  "rewrites": [
    {
      "source": "/p/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Google-Structured-Data-Testing-Tool|bingbot).*"
        }
      ],
      "destination": "https://jwsoutcwgwwfovrdrmjk.supabase.co/functions/v1/og-card?u=:username"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
